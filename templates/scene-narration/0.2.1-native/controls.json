{
  "presentationStyle": "scene-narration",
  "fullFilmTheme": "dark-tech",
  "currentEntityCount": [
    1,
    3
  ],
  "brands": {
    "logo": "required local image UUID",
    "sourceRecordRequired": true,
    "rule": "使用产品自身的官方标识，不能把公司/模型/用户自定义头像混作Agent专用图标"
  },
  "presenter": {
    "sharedSource": true,
    "sourceClock": true,
    "positionSizeRadiusInterpolation": true,
    "transitionSeconds": 0.62,
    "pipSide": "lower-left",
    "originalVideoRequired": true
  },
  "sceneKinds": [
    "hook",
    "promise",
    "identity",
    "workflow",
    "access",
    "bridge",
    "communication",
    "skills",
    "ecosystem",
    "opinion",
    "proactive",
    "approval",
    "boundary",
    "model",
    "comparison",
    "close"
  ],
  "motion": {
    "order": [
      "container",
      "title",
      "detail",
      "relationship",
      "result"
    ],
    "staggerSeconds": [
      0.12,
      0.35
    ],
    "seekDeterministic": true
  },
  "AI": {
    "binding": "local generation job and asset ID",
    "optionalWindow": [
      "startAt",
      "endAt",
      "offset"
    ],
    "autoPaidRetry": false,
    "reuseAcceptedLocalAssets": true,
    "generatedAudio": false
  },
  "captionPolicy": {
    "mode": "verbatim-subset",
    "originalSpeech": "all preserved unless explicitly changed by user",
    "strongClaims": "omit from visible captions when requested",
    "noSyntheticRewriteAsLiteralCaption": true,
    "singleLine": true,
    "trailingPunctuation": false
  },
  "audio": {
    "BGMlibrary": "{BGM_LIBRARY}",
    "ducking": true,
    "targetLUFS": [
      -17,
      -15
    ],
    "maxTruePeakDbtp": -1
  },
  "scope": "当前原生首片验收竖屏深色科技风，横屏/白色流程风仍需单独适配与验收"
}